tags: $:/Tekan/Main/ListFooter
title: $:/Tekan/AddCard
type: text/vnd.tiddlywiki

\define newHereButtonTags()
[[$(currentList)$]]
\end

\define addCard()
<$set name="random" filter="[[]make[RANDOM(10)]]">
<$action-createtiddler $basetitle=<<random>> text={{$:/NewNote}} tags=<<newHereButtonTags>> />
<$action-listops $tiddler=<<currentList>> $subfilter=<<random>>/>
</$set>
<$action-setfield $tiddler="$:/NewNote" text=""/>
<$action-setfield $tiddler="$:/state/AddCard" text=""/>
<$action-sendmessage $message="tm-auto-save-wiki"/>
\end

\define cancelCard()
<$action-setfield $tiddler="$:/NewNote" text=""/>
<$action-setfield $tiddler="$:/state/AddCard" text=""/>
\end

<$set name="addcardstate" value={{$:/state/AddCard}}>
<$list filter="[<addcardstate>!match<currentList>]" variable="ignore">
	<$button class="tc-btn-invisible" set="$:/state/AddCard" setTo=<<currentList>>><<tekan-lingo AddCard/Button>></$button>
</$list>
<$list filter="[<addcardstate>match<currentList>]" variable="ignore">
	<$keyboard key="ctrl+enter" actions=<<addCard>> tag="div">
	<$edit-text autoHeight="yes" focus="yes" placeholder={{$:/language/plugins/tesseract/tekan/AddCard/Placeholder}} default={{$:/language/plugins/tesseract/tekan/AddCard/Default}} tiddler="$:/NewNote"/>
	</$keyboard>
	<$button class="smallgreenbutton" actions=<<addCard>>><<tekan-lingo AddCard/Add>></$button>
	<$button class="tc-btn-invisible" style="margin: 0 5px;" actions=<<cancelCard>>>{{$:/core/images/close-button}}</$button>
</$list>
</$set>