type: text/vnd.tiddlywiki

\define newHereButtonTags()
[[$(currentList)$]]
\end

\define addCard()
<$set name="random" filter="[[]make[RANDOM(10)]]">
<$action-createtiddler $basetitle=<<random>> text={{$:/NewNote}} tags=<<newHereButtonTags>> />
<$action-listops $tiddler=<<currentList>> $subfilter=<<random>>/>
</$set>
<$action-setfield $tiddler="$:/NewNote" text=""/>
<$action-setfield $tiddler="$:/state/AddCard" text=""/>
<$action-sendmessage $message="tm-auto-save-wiki"/>
\end

\define cancelCard()
<$action-setfield $tiddler="$:/NewNote" text=""/>
<$action-setfield $tiddler="$:/state/AddCard" text=""/>
\end

DEBUG currentList=<<currentList>>
<$button style="display:block;color:#333;background:#fff;border:1px solid #aaa;padding:5px;width:100%;text-align:left;cursor:pointer;" set="$:/state/AddCard" setTo=<<currentList>>>+ Ajouter une tâche</$button>