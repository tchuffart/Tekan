caption: Edit Modal Sidebar
created: 20170925145058583
modified: 20170930111344745
tags: $:/Tikan/EditCardModal
title: $:/Tikan/EditCardModal/SideBar
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/plugins/tesseract/tekan/
<div class="window-module u-clearfix">
		<$button class="button-link" style="background: #EE6E73;color: #eee;"
        		tooltip=<<lingo Card/Sidebar/DeleteTooltip>>><<lingo Card/Sidebar/Delete>>
			<$action-deletetiddler $tiddler=<<currentCard>>/>
            <$action-deletetiddler $filter="[tag<currentCard>]"/>
			<$action-sendmessage $message="tm-close-tiddler"/>
            <$action-listops $tiddler=<<currentList>> $subfilter="+[remove<currentCard>]"/>
		</$button>
		<$button class="button-link" tooltip=<<lingo Card/Sidebar/ArchiveTooltip>>><<lingo Card/Sidebar/Archive>>
			<$action-listops $tiddler=<<currentCard>> $tags="archive"/>
            <$action-listops $tiddler=<<currentList>> $subfilter="+[remove<currentCard>]"/>
		</$button>
        <$button
        	class="button-link"
            actions=<<archivechecklist>>
            tooltip=<<lingo Card/Sidebar/ArchiveChecklistTooltip>>>
            <<lingo Card/Sidebar/ArchiveChecklist>>
        </$button>
        <$button
        	class="button-link" tooltip=<<lingo Card/Sidebar/LabelTooltip>>>
           		<$action-sendmessage
                $message="tm-modal"
                $param="$:/Tikan/EditCardModal/SideBar/LabelModal"
                currentCard=<<currentCard>>/>
            <<lingo Card/Sidebar/Label>>
 		</$button>
        <$edit-date
        	class="button-link"
            attributes="$:/Tikan/EditCardModal/SideBar/DueDateAttributes"
            tiddler=<<currentCard>>
            field="duedate"
            placeholder=<<lingo Card/Sidebar/DueDate>>/>
		<$button
        	class="button-link" tooltip=<<lingo Card/Sidebar/DoneTooltip>>>
            <<lingo Card/Sidebar/Done>>
			<$action-sendmessage $message="tm-close-tiddler"/>
            <$action-sendmessage $message="tm-auto-save-wiki"/>
            <$action-setfield $tiddler="$:/state/editcardtitle" text=""/>
		</$button>
        <$list filter="[tag[$:/Tikan/EditCardButton]]">
        <$transclude/>
        </$list>
</div>